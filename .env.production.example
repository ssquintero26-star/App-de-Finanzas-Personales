# Copiar a .env en el servidor y sustituir todos los valores de ejemplo.
DJANGO_SETTINGS_MODULE=fintrack.production
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=finanzas.example.com
CSRF_TRUSTED_ORIGINS=https://finanzas.example.com
SITE_URL=https://finanzas.example.com
TIME_ZONE=America/Bogota
# Activar únicamente si el proxy elimina la cabecera entrante del cliente
# y establece X-Forwarded-Proto de forma fiable.
TRUST_PROXY_HTTPS=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FinTrack <fintrack@example.com>
JWT_ENABLED=True
